# Keep this file's real values in .env. The builder never sends this file to agents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Set a tool-capable model ID available to your API account.
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-5.4
# Fully local OpenAI-compatible server. The base URL must resolve to literal
# 127.0.0.1 or ::1 over HTTP; hostnames and remote addresses are rejected.
LOCAL_MODEL=
LOCAL_API_BASE=http://127.0.0.1:11434/v1
# Screenshot sharing also requires opting in under Build controls.
# Enable only for a tested image-capable local model.
LOCAL_VISION=false
# When true, remote model providers and GitHub actions are blocked in the API.
OFFLINE_ONLY=false
# Required only when you choose a custom model whose standard rate is unknown.
# Values are USD per one million tokens and drive Local Foundry's conservative meter.
# ANTHROPIC_INPUT_USD_PER_MILLION=3
# ANTHROPIC_OUTPUT_USD_PER_MILLION=15
# OPENAI_INPUT_USD_PER_MILLION=2.5
# OPENAI_OUTPUT_USD_PER_MILLION=15
# Optional; setup.sh creates the builder database and access token.
BUILDER_PORT=8765
MAX_AGENT_STEPS=16

# Optional native mobile tools; use Linux paths inside WSL, or local macOS paths.
# ANDROID_HOME=/home/YOUR_USER/Android/Sdk
# JAVA_HOME=/path/to/jdk-21
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
