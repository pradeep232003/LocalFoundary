{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, tenant details, and subscription tier",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "subscriber", "member"] },
        "subscriptionTier": { "type": "string", "enum": ["free", "starter", "pro", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "past_due", "canceled", "trialing"] },
        "projectsQuota": { "type": "number" },
        "aiTokensQuota": { "type": "number" },
        "aiTokensUsed": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "Subscription tiers available on LocalFoundry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "priceMonthly": { "type": "number" },
        "maxProjects": { "type": "number" },
        "ragVectorIndexIncluded": { "type": "boolean" },
        "mobileBuildsEnabled": { "type": "boolean" },
        "tokenQuotaMonthly": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "priceMonthly"]
    },
    "TenantOrganization": {
      "title": "TenantOrganization",
      "description": "Tenant organizations subscribing to LocalFoundry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "tier": { "type": "string" },
        "status": { "type": "string" },
        "monthlySpend": { "type": "number" },
        "activeProjectsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerUid"]
    },
    "SystemAuditLog": {
      "title": "SystemAuditLog",
      "description": "Administrative events and audit logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "string" }
      },
      "required": ["id", "actorEmail", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile with role check and subscription limits"
    },
    "/plans/{planId}": {
      "schema": "SubscriptionPlan",
      "description": "Available subscription tiers"
    },
    "/tenants/{tenantId}": {
      "schema": "TenantOrganization",
      "description": "Subscribed customer organizations"
    },
    "/audit_logs/{logId}": {
      "schema": "SystemAuditLog",
      "description": "Administrative actions log"
    }
  }
}
