rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Only the Admin SDK may grant this custom claim. Profile fields and email
    // addresses never confer authority, including previously forged profiles.
    function admin() { return signedIn() && request.auth.token.super_admin == true; }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','email','displayName','photoURL','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.updatedAt == request.time;
      // Roles, quotas, billing fields and deletion are server-admin operations.
      allow delete: if false;
    }
    match /plans/{id} { allow read: if true; allow write: if admin(); }
    match /tenants/{id} {
      allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if admin();
    }
    match /audit_logs/{id} {
      allow read: if admin();
      allow write: if false; // Append from trusted server code only.
    }
    match /activity_events/{id} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId','type','title','timestamp'])
        && request.resource.data.keys().hasAll(['userId','type','title','timestamp'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['user_login','app_created','app_build']
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
